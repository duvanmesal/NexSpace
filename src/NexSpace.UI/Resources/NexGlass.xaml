<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:NexSpace.UI.Controls">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="NexSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NexSolidSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NexElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NexTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NexSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NexWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NexDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NexSeaBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NexBlueBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NexCopperBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
    <SolidColorBrush x:Key="NexSurfaceBrush" Color="#30171E26" />
    <SolidColorBrush x:Key="NexSolidSurfaceBrush" Color="#22272E" />
    <SolidColorBrush x:Key="NexElevatedBrush" Color="#302F3943" />
    <SolidColorBrush x:Key="NexDividerBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="NexTextBrush" Color="#F2F5F7" />
    <SolidColorBrush x:Key="NexSecondaryTextBrush" Color="#C2CAD2" />
    <SolidColorBrush x:Key="NexWarningBrush" Color="#F1C58D" />
    <SolidColorBrush x:Key="NexSeaBrush" Color="#92CDBB" />
    <SolidColorBrush x:Key="NexBlueBrush" Color="#91BFE3" />
    <SolidColorBrush x:Key="NexCopperBrush" Color="#DEA78E" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#355E8B81" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#456B9A8F" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <x:Double x:Key="NexGlassTintOpacity">0.45</x:Double>
    <x:Double x:Key="NexGlassLuminosityOpacity">0.65</x:Double>
    <CornerRadius x:Key="NexPanelCornerRadius">12</CornerRadius>
    <Style x:Key="NexTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" /><Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{ThemeResource NexTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="NexQuietButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="32" /><Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{ThemeResource NexSecondaryTextBrush}" />
    </Style>
    <Style x:Key="NexReferenceItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="2" /><Setter Property="Margin" Value="2" />
        <Setter Property="CornerRadius" Value="8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="NexLibrarySurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NexElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NexDividerBrush}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource NexPanelCornerRadius}" />
        <Setter Property="Margin" Value="0,0,0,9" />
    </Style>
    <ItemsPanelTemplate x:Key="NexGridItemsPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="108" ItemHeight="112" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="NexListItemsPanel"><ItemsStackPanel /></ItemsPanelTemplate>
    <DataTemplate x:Key="NexReferenceTemplate"><controls:ReferenceTile /></DataTemplate>
</ResourceDictionary>
