<Page x:Class="NexSpace.UI.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RequestedTheme="Dark" Background="{ThemeResource NexSolidSurfaceBrush}" RowDefinitions="Auto,*,Auto">
  <Border Padding="24,16" BorderBrush="{ThemeResource NexDividerBrush}" BorderThickness="0,0,0,1">
   <Grid ColumnDefinitions="*,Auto">
    <StackPanel Spacing="4"><TextBlock Text="NexManager" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Una biblioteca. Tus originales permanecen intactos." Foreground="{ThemeResource NexSecondaryTextBrush}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Mostrar dock" Click="Dock_Click"/><Button Content="Recuperar ventanas" Click="Recover_Click"/><Button Content="Salir" Click="Exit_Click"/></StackPanel>
   </Grid>
  </Border>
  <Pivot x:Name="ManagerSections" Grid.Row="1" Margin="16,4">
   <PivotItem Header="Contenedores">
    <Grid RowDefinitions="Auto,*" RowSpacing="16" Margin="8,12">
     <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Nuevo contenedor" Click="Create_Click"/><Button Content="Actualizar" Click="Refresh_Click"/><TextBlock Text="Abre un contenedor para editarlo." VerticalAlignment="Center" Foreground="{ThemeResource NexSecondaryTextBrush}"/></StackPanel>
     <ListView Grid.Row="1" x:Name="ContainersList" ItemsSource="{Binding Containers}" IsItemClickEnabled="True" ItemClick="Container_ItemClick" RightTapped="Container_RightTapped" SelectionMode="Single" HorizontalContentAlignment="Stretch">
      <ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource NexLibrarySurfaceStyle}" Padding="16,12"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" Style="{StaticResource NexTitleStyle}"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Items.Count}"/><TextBlock Text="referencias · FLOATING" Foreground="{ThemeResource NexSecondaryTextBrush}"/></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="Abrir" Foreground="{ThemeResource NexSeaBrush}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </PivotItem>
   <PivotItem Header="Dock y categorías">
    <Grid ColumnDefinitions="280,*" ColumnSpacing="20" Margin="8,12">
     <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
      <Button Content="Nueva categoría" Click="CreateCategory_Click"/>
      <ListView Grid.Row="1" x:Name="CategoriesList" ItemsSource="{Binding Categories}" SelectionChanged="Category_SelectionChanged"><ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12" Padding="8"><FontIcon Glyph="{Binding Glyph}" FontSize="20"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="180"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6"><Button Content="↑" AutomationProperties.Name="Subir categoría" Click="CategoryUp_Click"/><Button Content="↓" AutomationProperties.Name="Bajar categoría" Click="CategoryDown_Click"/><Button Content="Editar" Click="EditCategory_Click"/><Button Content="Quitar…" Click="DeleteCategory_Click"/></StackPanel>
     </Grid>
     <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
      <StackPanel Spacing="5"><TextBlock x:Name="CategoryTitle" Text="Selecciona una categoría" Style="{StaticResource NexTitleStyle}"/><TextBlock x:Name="CategoryHint" Text="Crea una categoría propia o enlaza un contenedor." TextWrapping="Wrap" Foreground="{ThemeResource NexSecondaryTextBrush}"/></StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="Archivos…" Click="PickFiles_Click"/><Button Content="Carpeta…" Click="PickFolder_Click"/><Button Content="Añadir destino…" Click="AddTarget_Click"/></StackPanel>
      <ListView Grid.Row="2" x:Name="DockItemsList" ItemTemplate="{StaticResource NexReferenceTemplate}" ItemContainerStyle="{StaticResource NexReferenceItemStyle}" IsItemClickEnabled="True" ItemClick="DockItem_Click" RightTapped="DockItem_RightTapped"/>
      <TextBlock Grid.Row="3" Text="Clic para abrir con Windows. Clic derecho: nombre, orden y quitar referencia." TextWrapping="Wrap" Foreground="{ThemeResource NexSecondaryTextBrush}"/>
     </Grid>
    </Grid>
   </PivotItem>
   <PivotItem Header="Preferencias">
    <ScrollViewer><StackPanel Margin="8,12" Spacing="16" MaxWidth="660" HorizontalAlignment="Left">
     <TextBlock Text="Posición y apariencia del dock" Style="{StaticResource NexTitleStyle}"/>
     <Grid ColumnDefinitions="*,*" ColumnSpacing="16"><ComboBox x:Name="EdgeBox" Header="Anclaje" HorizontalAlignment="Stretch"/><ComboBox Grid.Column="1" x:Name="MonitorBox" Header="Monitor" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/></Grid>
     <Grid ColumnDefinitions="*,*" ColumnSpacing="16"><NumberBox x:Name="XBox" Header="X libre (DIP)" Minimum="-100000" Maximum="100000"/><NumberBox Grid.Column="1" x:Name="YBox" Header="Y libre (DIP)" Minimum="-100000" Maximum="100000"/></Grid>
     <Grid ColumnDefinitions="*,*" ColumnSpacing="16"><NumberBox x:Name="SizeBox" Header="Tamaño del acceso (32–64 DIP)" Minimum="32" Maximum="64"/><ComboBox Grid.Column="1" x:Name="AccentBox" Header="Acento NexGlass" HorizontalAlignment="Stretch"/></Grid>
     <TextBlock Text="Al iniciar NexSpace" Style="{StaticResource NexTitleStyle}"/>
     <CheckBox x:Name="StartupDockBox" Content="Mostrar NexDock"/><CheckBox x:Name="RestoreBox" Content="Restaurar contenedores abiertos"/><CheckBox x:Name="StartupManagerBox" Content="Mostrar NexManager"/>
     <Button Content="Guardar preferencias" Click="SaveSettings_Click" HorizontalAlignment="Left"/>
     <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Inicio con Windows deshabilitado" Message="No se registra autoarranque. Estas opciones solo se aplican al abrir NexSpace."/>
     <TextBlock Text="Auto-ocultamiento no disponible: se mantienen controles visibles y recuperación independiente. Materiales y animaciones respetan la política de Windows." TextWrapping="Wrap" Foreground="{ThemeResource NexSecondaryTextBrush}"/>
    </StackPanel></ScrollViewer>
   </PivotItem>
   <PivotItem Header="Diagnóstico">
    <ScrollViewer><StackPanel Margin="8,12" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
     <TextBlock Text="Una sesión integrada, solo FLOATING" Style="{StaticResource NexTitleStyle}"/>
     <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="DESKTOP experimental y deshabilitado" Message="No se usa HWND_BOTTOM ni se modifica Explorer o sus iconos."/>
     <TextBlock x:Name="DiagnosticText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Actualizar diagnóstico" Click="Diagnostics_Click"/><Button Content="Abrir carpeta de registros" Click="Logs_Click"/></StackPanel>
     <TextBlock Text="Recuperar ventanas o Ctrl+Alt+Shift+F12 restaura contenedores, dock y NexManager. Cerrar NexManager o pulsar Salir cierra toda la sesión; las aplicaciones abiertas con Windows son independientes." TextWrapping="Wrap"/>
     <TextBlock Text="Fase 1 aceptada condicionalmente: pendientes drag-and-drop físico, accesibilidad, DPI/multimonitor, translucidez, animaciones y perfilado de memoria." TextWrapping="Wrap" Foreground="{ThemeResource NexSecondaryTextBrush}"/>
    </StackPanel></ScrollViewer>
   </PivotItem>
  </Pivot>
  <Border Grid.Row="2" Background="{ThemeResource NexElevatedBrush}" Padding="24,10"><TextBlock Text="{Binding Status}" Foreground="{ThemeResource NexSecondaryTextBrush}" TextWrapping="Wrap"/></Border>
 </Grid>
</Page>
