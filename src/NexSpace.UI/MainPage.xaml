<Page x:Class="NexSpace.UI.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid RequestedTheme="Dark" Background="{ThemeResource NexSurfaceBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="28,22" Background="{ThemeResource NexElevatedBrush}" BorderBrush="{ThemeResource NexDividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5"><TextBlock Text="NEXSPACE" CharacterSpacing="180" FontSize="12" Foreground="{ThemeResource NexSeaBrush}" FontWeight="SemiBold"/><TextBlock Text="Tu escritorio, en su sitio." FontSize="26" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="＋ Nuevo contenedor" Click="Create_Click" Padding="16,10"/><Button Content="Recuperar paneles" Click="Recover_Click"/><Button Content="Diagnóstico" Click="Diagnostics_Click"/><Button Content="Salir" Click="Exit_Click"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="28" MaxWidth="1040" HorizontalAlignment="Left" RowDefinitions="Auto,*" RowSpacing="18">
            <Border Background="{ThemeResource NexElevatedBrush}" BorderBrush="{ThemeResource NexDividerBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20"><StackPanel Spacing="5"><TextBlock Text="NEXCONTAINERS" CharacterSpacing="110" FontSize="11" Foreground="{ThemeResource NexSeaBrush}"/><TextBlock Text="Organiza con referencias; conserva intactos tus originales." FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Los contenedores usan ventanas FLOATING. La integración DESKTOP sigue experimental y no se usa aquí." Foreground="{ThemeResource NexSecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="＋ Crear" Click="Create_Click" VerticalAlignment="Center" Padding="18,12"/></Grid>
            </Border>
            <Grid Grid.Row="1">
                <ListView x:Name="ContainersList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Container_ItemClick" RightTapped="Container_RightTapped" />
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><TextBlock Text="Todavía no hay contenedores" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Crea un espacio y añade referencias a tus archivos, carpetas y aplicaciones." Foreground="{ThemeResource NexSecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="450" TextAlignment="Center"/><Button Content="Crear mi primer contenedor" Click="Create_Click" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{ThemeResource NexElevatedBrush}" Padding="20,12"><Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="StatusText" Text="FLOATING · almacenamiento local" Foreground="{ThemeResource NexSecondaryTextBrush}" FontSize="12"/><TextBlock Grid.Column="1" Text="Fase 1 · NexContainers" Foreground="{ThemeResource NexSecondaryTextBrush}" FontSize="12"/></Grid></Border>
    </Grid>
</Page>
