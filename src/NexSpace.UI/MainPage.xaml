<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="NexSpace.UI.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="using:NexSpace.UI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid Background="#10161B">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Padding="28,24" Background="#151E24" BorderBrush="#28353D" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5"><TextBlock Text="NEXSPACE" CharacterSpacing="180" FontSize="12" Foreground="#65D6C2" FontWeight="SemiBold"/><TextBlock Text="Escritorio, en su sitio." FontSize="26" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Diagnóstico" Click="Diagnostics_Click"/><Button Content="Salir" Click="Exit_Click"/></StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28" Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
                <Border Background="#172229" BorderBrush="#30434C" BorderThickness="1" CornerRadius="16" Padding="24">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <StackPanel Spacing="7"><TextBlock Text="PANEL DE DEMOSTRACIÓN" CharacterSpacing="100" FontSize="11" Foreground="#8FA8B1"/><TextBlock Text="Un espacio compacto. Centro despejado." FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Sin archivos reales ni cambios en el Shell. Mueve y ajusta el panel para probar la experiencia flotante." Foreground="#B7C5C9" TextWrapping="Wrap" MaxWidth="570"/></StackPanel>
                        <Button x:Name="PanelButton" Grid.Column="1" Content="Abrir panel" Click="Panel_Click" VerticalAlignment="Center" Padding="20,12"/>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,16" Height="1" Background="#30434C"/>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="MODO" FontSize="11" CharacterSpacing="90" Foreground="#8FA8B1" VerticalAlignment="Center"/><TextBlock x:Name="ModeText" Text="FLOATING" Foreground="#65D6C2" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="·" Foreground="#52636A" VerticalAlignment="Center"/><TextBlock x:Name="IntegrationText" Text="Listo · ventana independiente" Foreground="#B7C5C9" VerticalAlignment="Center"/></StackPanel>
                    </Grid>
                </Border>
                <Border Background="#18302E" BorderBrush="#315A53" BorderThickness="1" CornerRadius="14" Padding="20">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="6"><TextBlock Text="RECUPERACIÓN DE EMERGENCIA" FontSize="11" CharacterSpacing="90" Foreground="#65D6C2"/><TextBlock x:Name="RecoveryText" Text="Atajo global: verificando…" TextWrapping="Wrap" Foreground="#C5D8D4"/></StackPanel>
                        <Button Grid.Column="1" Content="Restaurar todos a FLOATING" Click="EmergencyRestore_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                    <Border Background="#151E24" BorderBrush="#28353D" BorderThickness="1" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="DESKTOP · EXPERIMENTAL" FontSize="11" CharacterSpacing="90" Foreground="#E5B96D"/><TextBlock Text="Orden Z bajo, sin acoplarse a Explorer." FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="No es integración certificada. Requiere confirmación antes de cada prueba y puede ocultar el panel tras otras ventanas." Foreground="#B7C5C9" TextWrapping="Wrap"/><Button x:Name="DesktopButton" Content="Probar modo Desktop…" Click="Desktop_Click" HorizontalAlignment="Left" Margin="0,4,0,0"/></StackPanel></Border>
                    <Border Grid.Column="1" Background="#151E24" BorderBrush="#28353D" BorderThickness="1" CornerRadius="14" Padding="20"><StackPanel Spacing="10"><TextBlock Text="ENTORNO" FontSize="11" CharacterSpacing="90" Foreground="#8FA8B1"/><TextBlock x:Name="DisplayText" Text="Leyendo monitores…" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Iconos originales: consulta no disponible. NexSpace no los oculta ni cambia su configuración." Foreground="#B7C5C9" TextWrapping="Wrap"/><Button Content="Restaurar posición segura" Click="Restore_Click" HorizontalAlignment="Left" Margin="0,4,0,0"/></StackPanel></Border>
                </Grid>
                <TextBlock Text="Fase 0 · Validación técnica · Ningún archivo personal es leído o modificado" Foreground="#71858D" FontSize="12" Margin="2,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
