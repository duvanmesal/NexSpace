<Page x:Class="NexSpace.UI.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vis="using:NexSpace.UI.Visuals">
 <Page.Resources>
  <vis:WorkspaceColorConverter x:Key="WsColor"/>
  <Style x:Key="NamedEntityItemStyle" TargetType="ListViewItem">
   <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <DataTemplate x:Key="WorkspaceCardTemplate">
   <Grid ColumnSpacing="13" Padding="4,7">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Rectangle Width="4" Height="30" RadiusX="2" RadiusY="2" Fill="{Binding Id, Converter={StaticResource WsColor}}"/>
    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
   </Grid>
  </DataTemplate>
 </Page.Resources>
 <Grid x:Name="ManagerRoot" Background="{ThemeResource NexSolidSurfaceBrush}" RowDefinitions="Auto,*,Auto">
  <Border Padding="24,16" BorderBrush="{ThemeResource NexDividerBrush}" BorderThickness="0,0,0,1">
   <Grid ColumnDefinitions="*,Auto">
    <StackPanel Spacing="4"><TextBlock Text="NexManager" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Una biblioteca. Tus originales permanecen intactos." Foreground="{ThemeResource NexSecondaryTextBrush}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <Button Content="Mostrar dock" Click="Dock_Click"/><Button Content="Recuperar ventanas" Click="Recover_Click"/>
     <Rectangle Width="1" Height="20" Fill="{ThemeResource NexDividerBrush}" Margin="4,0"/>
     <Button Content="Salir" Style="{StaticResource NexDestructiveButtonStyle}" AutomationProperties.Name="Salir de NexSpace" ToolTipService.ToolTip="Cierra NexManager y toda la sesión de NexSpace" Click="Exit_Click"/>
    </StackPanel>
   </Grid>
  </Border>
  <NavigationView x:Name="ManagerNav" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Left" OpenPaneLength="210" SelectionChanged="Navigation_Changed">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="Inicio" Tag="Home" Icon="Home" IsSelected="True"/>
    <NavigationViewItem Content="Contenedores" Tag="Containers" Icon="Library"/>
    <NavigationViewItem Content="Dock y categorías" Tag="Dock" Icon="AllApps"/>
    <NavigationViewItem Content="Espacios de trabajo" Tag="Profiles" Icon="People"/>
    <NavigationViewItem Content="Apariencia" Tag="Appearance" Icon="Highlight"/>
    <NavigationViewItem Content="Preferencias" Tag="Preferences" Icon="Setting"/>
    <NavigationViewItem Content="Diagnóstico" Tag="Diagnostics" Icon="Repair"/>
   </NavigationView.MenuItems>
   <Grid Margin="24,12">
   <ScrollViewer x:Name="HomeSection"><StackPanel Spacing="20" MaxWidth="880" HorizontalAlignment="Left" Padding="2,2,2,28">
    <!-- Editorial "now" panel: active workspace with copper identity edge -->
    <Border Style="{StaticResource NexHeroPanelStyle}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Rectangle x:Name="HomeHeroEdge" Fill="{ThemeResource NexSeaBrush}" RadiusX="2.5" RadiusY="2.5"/>
      <StackPanel Grid.Column="1" Spacing="7" Padding="26,24">
       <TextBlock Text="ESPACIO ACTIVO" Style="{StaticResource NexEyebrowStyle}" Foreground="{ThemeResource NexSeaBrush}"/>
       <TextBlock x:Name="ActiveProfileText" Text="Principal" FontSize="34" FontWeight="SemiBold" LineHeight="38"/>
       <TextBlock x:Name="DashboardSummary" Text="Organiza referencias sin mover tus archivos originales." TextWrapping="Wrap" Foreground="{ThemeResource NexSecondaryTextBrush}" FontSize="14.5"/>
       <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
        <Button Style="{StaticResource NexAccentButtonStyle}" Click="Create_Click">
         <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="14"/><TextBlock Text="Nuevo contenedor"/></StackPanel>
        </Button>
        <Button Content="Mostrar dock" Click="Dock_Click"/>
       </StackPanel>
      </StackPanel>
     </Grid>
    </Border>
    <!-- Live metric tiles -->
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Style="{StaticResource NexStatTileStyle}"><StackPanel Spacing="5"><TextBlock x:Name="TileContainers" Text="0" Style="{StaticResource NexStatNumberStyle}"/><TextBlock Text="CONTENEDORES" Style="{StaticResource NexEyebrowStyle}" FontSize="10.5"/></StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource NexStatTileStyle}"><StackPanel Spacing="5"><TextBlock x:Name="TileCategories" Text="0" Style="{StaticResource NexStatNumberStyle}"/><TextBlock Text="CATEGORÍAS" Style="{StaticResource NexEyebrowStyle}" FontSize="10.5"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource NexStatTileStyle}"><StackPanel Spacing="5"><TextBlock x:Name="TileReferences" Text="0" Style="{StaticResource NexStatNumberStyle}"/><TextBlock Text="REFERENCIAS" Style="{StaticResource NexEyebrowStyle}" FontSize="10.5"/></StackPanel></Border>
     <Border Grid.Column="3" Style="{StaticResource NexStatTileStyle}"><StackPanel Spacing="5"><TextBlock x:Name="TileTheme" Text="Cobre" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource NexSeaBrush}"/><TextBlock Text="TEMA ACTIVO" Style="{StaticResource NexEyebrowStyle}" FontSize="10.5"/></StackPanel></Border>
    </Grid>
    <!-- Secure access note -->
    <Border Style="{StaticResource NexLibrarySurfaceStyle}" Padding="18,15" Margin="0,2,0,0">
     <StackPanel Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="{ThemeResource NexSeaBrush}"/><TextBlock Text="Acceso seguro" Style="{StaticResource NexTitleStyle}"/></StackPanel>
      <TextBlock Text="Ctrl + Alt + Shift + F12 recupera tus ventanas desde cualquier aplicación. FLOTANTE activo; DESKTOP deshabilitado." TextWrapping="Wrap" Foreground="{ThemeResource NexSecondaryTextBrush}" FontSize="13"/>
     </StackPanel>
    </Border>
   </StackPanel></ScrollViewer>
   <Grid x:Name="ContainersSection" Visibility="Collapsed">
    <Grid RowDefinitions="Auto,*" RowSpacing="16" Margin="8,12">
     <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Nuevo contenedor" Click="Create_Click"/><Button Content="Actualizar" Click="Refresh_Click"/><TextBlock Text="Abre un contenedor para editarlo." VerticalAlignment="Center" Foreground="{ThemeResource NexSecondaryTextBrush}"/></StackPanel>
     <Grid Grid.Row="1">
      <ListView x:Name="ContainersList" ItemContainerStyle="{StaticResource NamedEntityItemStyle}" ItemsSource="{Binding Containers}" IsItemClickEnabled="True" ItemClick="Container_ItemClick" RightTapped="Container_RightTapped" SelectionMode="Single" HorizontalContentAlignment="Stretch">
       <ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource NexLibrarySurfaceStyle}" Padding="16,12"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" Style="{StaticResource NexTitleStyle}"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Items.Count}"/><TextBlock Text="referencias · FLOATING" Foreground="{ThemeResource NexSecondaryTextBrush}"/></StackPanel></StackPanel><Border Grid.Column="1" Style="{StaticResource NexAffordanceChipStyle}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8A7;" FontSize="12" Foreground="{ThemeResource NexSeaBrush}"/><TextBlock Text="Abrir" Foreground="{ThemeResource NexSeaBrush}" FontSize="12"/></StackPanel></Border></Grid></Border></DataTemplate></ListView.ItemTemplate>
      </ListView>
      <StackPanel x:Name="ContainersEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed" MaxWidth="320">
       <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="32" Foreground="{ThemeResource NexSecondaryTextBrush}" HorizontalAlignment="Center"/>
       <TextBlock Text="Aún no tienes contenedores" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       <TextBlock Text="Un contenedor agrupa referencias a archivos, carpetas o apps sin moverlas de su ubicación." Foreground="{ThemeResource NexSecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
       <Button Content="Nuevo contenedor" Click="Create_Click" HorizontalAlignment="Center"/>
      </StackPanel>
     </Grid>
    </Grid>
   </Grid>
   <Grid x:Name="DockSection" Visibility="Collapsed">
    <Grid ColumnDefinitions="280,*" ColumnSpacing="20" Margin="8,12">
     <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
      <Button Content="Nueva categoría" Click="CreateCategory_Click"/>
      <Grid Grid.Row="1">
       <ListView x:Name="CategoriesList" ItemsSource="{Binding Categories}" SelectionChanged="Category_SelectionChanged"><ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12" Padding="8"><FontIcon Glyph="{Binding Glyph}" FontSize="20"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="180"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
       <StackPanel x:Name="CategoriesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed" Padding="12">
        <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{ThemeResource NexSecondaryTextBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="Sin categorías todavía" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Text="Crea una para organizar accesos en el dock." Foreground="{ThemeResource NexSecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
       </StackPanel>
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
       <Button Style="{StaticResource NexQuietButtonStyle}" AutomationProperties.Name="Subir categoría" ToolTipService.ToolTip="Subir categoría" Click="CategoryUp_Click"><FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="14"/></Button>
       <Button Style="{StaticResource NexQuietButtonStyle}" AutomationProperties.Name="Bajar categoría" ToolTipService.ToolTip="Bajar categoría" Click="CategoryDown_Click"><FontIcon Glyph="&#xE74B;" FontFamily="Segoe Fluent Icons" FontSize="14"/></Button>
       <Button Content="Editar" Click="EditCategory_Click"/>
       <Rectangle Width="1" Height="20" Fill="{ThemeResource NexDividerBrush}" Margin="0,0,0,0"/>
       <Button Content="Quitar…" Style="{StaticResource NexDestructiveButtonStyle}" Click="DeleteCategory_Click"/>
      </StackPanel>
     </Grid>
     <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
      <StackPanel Spacing="5"><TextBlock x:Name="CategoryTitle" Text="Selecciona una categoría" Style="{StaticResource NexTitleStyle}"/><TextBlock x:Name="CategoryHint" Text="Crea una categoría propia o enlaza un contenedor." TextWrapping="Wrap" Foreground="{ThemeResource NexSecondaryTextBrush}"/></StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="Archivos…" Click="PickFiles_Click"/><Button Content="Carpeta…" Click="PickFolder_Click"/><Button Content="Añadir destino…" Click="AddTarget_Click"/></StackPanel>
      <Grid Grid.Row="2">
       <ListView x:Name="DockItemsList" ItemTemplate="{StaticResource NexReferenceTemplate}" ItemContainerStyle="{StaticResource NexReferenceItemStyle}" IsItemClickEnabled="True" ItemClick="DockItem_Click" RightTapped="DockItem_RightTapped"/>
       <StackPanel x:Name="DockItemsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False" Visibility="Collapsed">
        <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{ThemeResource NexSecondaryTextBrush}"/>
        <TextBlock Text="Esta categoría está vacía" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="Usa Archivos…, Carpeta… o Añadir destino… para añadir referencias." Foreground="{ThemeResource NexSecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="260" TextAlignment="Center"/>
       </StackPanel>
      </Grid>
      <TextBlock Grid.Row="3" Text="Clic para abrir con Windows. Clic derecho: nombre, orden y quitar referencia." TextWrapping="Wrap" Foreground="{ThemeResource NexSecondaryTextBrush}"/>
     </Grid>
    </Grid>
   </Grid>
   <ScrollViewer x:Name="ProfilesSection" Visibility="Collapsed"><StackPanel Spacing="16" MaxWidth="680" HorizontalAlignment="Left">
    <TextBlock Text="Espacios de trabajo" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock Text="Cada espacio conserva contenedores, referencias, dock y apariencia. Los cambios se guardan inmediatamente; cambiar de espacio no cierra otras aplicaciones." TextWrapping="Wrap"/>
    <TextBlock x:Name="ProfileStateText" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <ListView x:Name="ProfilesList" ItemContainerStyle="{StaticResource NamedEntityItemStyle}" ItemTemplate="{StaticResource WorkspaceCardTemplate}" MinWidth="400" MaxHeight="300"/>
    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Crear" Click="CreateProfile_Click"/><Button Content="Duplicar activo" Click="DuplicateProfile_Click"/><Button Content="Renombrar" Click="RenameProfile_Click"/><Button Content="Cambiar al seleccionado" Click="SwitchProfile_Click"/></StackPanel>
    <CheckBox x:Name="RestoreLastProfileBox" Content="Restaurar último espacio al iniciar"/>
    <Button Content="Usar seleccionado como predeterminado y guardar" Click="DefaultProfile_Click"/>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
     <Rectangle Width="1" Height="20" Fill="{ThemeResource NexDividerBrush}" Margin="0,0,4,0"/>
     <Button Content="Eliminar…" Style="{StaticResource NexDestructiveButtonStyle}" ToolTipService.ToolTip="No se puede eliminar el espacio activo ni el predeterminado" Click="DeleteProfile_Click"/>
    </StackPanel>
   </StackPanel></ScrollViewer>
   <ScrollViewer x:Name="AppearanceSection" Visibility="Collapsed"><StackPanel Spacing="16" MaxWidth="660" HorizontalAlignment="Left">
    <TextBlock Text="NexGlass · Apariencia" FontSize="26" FontWeight="SemiBold"/>
    <ComboBox x:Name="ThemeBox" Header="Tema del espacio" MinWidth="320" SelectionChanged="ThemeBox_SelectionChanged"/>
    <ComboBox x:Name="ThemeAccentBox" Header="Paleta de acento" MinWidth="320"/>
    <TextBlock x:Name="AutoThemeHint" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource NexSecondaryTextBrush}" Text="Automático sigue el tema claro/oscuro y el color de acento de Windows en tiempo real. La paleta de acento manual queda en pausa mientras este modo está activo."/>
    <ComboBox x:Name="FontBox" Header="Tipografía" MinWidth="320"/>
    <NumberBox x:Name="OpacityBox" Header="Densidad del material (0.65–1)" Minimum="0.65" Maximum="1" SmallChange="0.05" SpinButtonPlacementMode="Inline"/>
    <NumberBox x:Name="RadiusBox" Header="Radio de esquinas (0–24)" Minimum="0" Maximum="24" SpinButtonPlacementMode="Inline"/>
    <NumberBox x:Name="ThemeSpacingBox" Header="Espaciado (4–20)" Minimum="4" Maximum="20" SpinButtonPlacementMode="Inline"/>
    <CheckBox x:Name="MaterialBox" Content="Solicitar Acrylic compatible (alternativa sólida automática)"/>
    <Button Content="Aplicar a ventanas abiertas" Click="ApplyTheme_Click"/>
    <TextBlock Text="La opacidad controla el tinte del material, no vuelve transparente el texto. Contraste usa una paleta sólida; alto contraste y movimiento reducido de Windows tienen prioridad sobre cualquier tema, incluido Automático. Si Acrylic/Mica no está disponible, NexSpace usa un fondo sólido equivalente." TextWrapping="Wrap" Foreground="{ThemeResource NexSecondaryTextBrush}"/>
   </StackPanel></ScrollViewer>
   <Grid x:Name="PreferencesSection" Visibility="Collapsed">
    <ScrollViewer><StackPanel Margin="8,12" Spacing="12" MaxWidth="660" HorizontalAlignment="Left">
     <TextBlock Text="Preferencias" FontSize="26" FontWeight="SemiBold"/>
     <Expander Header="Posición y anclaje del dock" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="16" Padding="4,12">
       <Grid ColumnDefinitions="*,*" ColumnSpacing="16"><ComboBox x:Name="EdgeBox" Header="Anclaje" HorizontalAlignment="Stretch"/><ComboBox Grid.Column="1" x:Name="MonitorBox" Header="Monitor" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/></Grid>
       <Grid ColumnDefinitions="*,*" ColumnSpacing="16"><NumberBox x:Name="XBox" Header="X libre (DIP)" Minimum="-100000" Maximum="100000"/><NumberBox Grid.Column="1" x:Name="YBox" Header="Y libre (DIP)" Minimum="-100000" Maximum="100000"/></Grid>
      </StackPanel>
     </Expander>
     <Expander Header="Apariencia del dock" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="16" Padding="4,12">
       <Grid ColumnDefinitions="*,*" ColumnSpacing="16"><NumberBox x:Name="SizeBox" Header="Tamaño del acceso (32–64 DIP)" Minimum="32" Maximum="64"/><ComboBox Grid.Column="1" x:Name="AccentBox" Header="Acento NexGlass" HorizontalAlignment="Stretch"/></Grid>
       <ComboBox x:Name="OrientationBox" Header="Orientación"/><NumberBox x:Name="DockSpacingBox" Header="Espaciado del dock (4–20 DIP)" Minimum="4" Maximum="20"/><CheckBox x:Name="DockLabelsBox" Content="Mostrar etiquetas del dock"/>
      </StackPanel>
     </Expander>
     <Expander Header="Al iniciar NexSpace" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="12" Padding="4,12">
       <CheckBox x:Name="StartupDockBox" Content="Mostrar NexDock"/><CheckBox x:Name="RestoreBox" Content="Restaurar contenedores abiertos"/><CheckBox x:Name="StartupManagerBox" Content="Mostrar NexManager"/>
       <TextBlock x:Name="WindowsStartupText" Text="Inicio Windows: desactivado por defecto" TextWrapping="Wrap" Foreground="{ThemeResource NexSecondaryTextBrush}"/>
       <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Activar inicio con Windows…" Click="EnableStartup_Click"/><Button Content="Desactivar inicio Windows" Click="DisableStartup_Click"/></StackPanel>
      </StackPanel>
     </Expander>
     <Button Content="Guardar preferencias" Click="SaveSettings_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
     <TextBlock Text="Auto-ocultamiento no disponible: se mantienen controles visibles y recuperación independiente. Materiales y animaciones respetan la política de Windows." TextWrapping="Wrap" Foreground="{ThemeResource NexSecondaryTextBrush}"/>
    </StackPanel></ScrollViewer>
   </Grid>
   <Grid x:Name="DiagnosticsSection" Visibility="Collapsed">
    <ScrollViewer><StackPanel Margin="8,12" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
     <TextBlock Text="Una sesión integrada, solo FLOATING" Style="{StaticResource NexTitleStyle}"/>
     <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="DESKTOP experimental y deshabilitado" Message="No se usa HWND_BOTTOM ni se modifica Explorer o sus iconos."/>
     <TextBlock x:Name="DiagnosticText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Actualizar diagnóstico" Click="Diagnostics_Click"/><Button Content="Abrir carpeta de registros" Click="Logs_Click"/></StackPanel>
     <Button Content="Crear copia de respaldo SQLite" Click="Backup_Click" HorizontalAlignment="Left"/>
     <TextBlock Text="Recuperar ventanas o Ctrl+Alt+Shift+F12 restaura contenedores, dock y NexManager. Cerrar NexManager o pulsar Salir cierra toda la sesión; las aplicaciones abiertas con Windows son independientes." TextWrapping="Wrap"/>
     <TextBlock Text="Fase 1 aceptada condicionalmente: pendientes drag-and-drop físico, accesibilidad, DPI/multimonitor, translucidez, animaciones y perfilado de memoria." TextWrapping="Wrap" Foreground="{ThemeResource NexSecondaryTextBrush}"/>
    </StackPanel></ScrollViewer>
   </Grid>
   </Grid>
  </NavigationView>
  <Border Grid.Row="2" Background="{ThemeResource NexElevatedBrush}" Padding="24,10"><TextBlock Text="{Binding Status}" Foreground="{ThemeResource NexSecondaryTextBrush}" TextWrapping="Wrap"/></Border>
 </Grid>
</Page>
