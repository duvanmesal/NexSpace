<UserControl x:Class="NexSpace.UI.Controls.ReferenceTile" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="LayoutRoot" Padding="6" RowSpacing="6" ColumnSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
        <Grid x:Name="IconHost" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon x:Name="FallbackIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="30" Foreground="{ThemeResource NexSecondaryTextBrush}" />
            <Image x:Name="NativeIcon" Stretch="Uniform" />
        </Grid>
        <StackPanel x:Name="Labels" Grid.Row="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock x:Name="NameLabel" Text="{Binding DisplayName}" FontSize="12" Foreground="{ThemeResource NexTextBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
            <TextBlock x:Name="ErrorLabel" Text="{Binding StatusMessage}" FontSize="10" Foreground="{ThemeResource NexWarningBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
